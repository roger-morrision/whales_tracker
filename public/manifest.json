    },
    {
      "name": "Portfolio",
      "short_name": "Portfolio",
      "description": "View your portfolio and PnL",
      "url": "/?tab=portfolio",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Whales",
      "short_name": "Whales",
